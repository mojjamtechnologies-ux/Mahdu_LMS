diff -ruN a/server/src/db/migrations/018_profile_idcards.sql b/server/src/db/migrations/018_profile_idcards.sql
--- a/server/src/db/migrations/018_profile_idcards.sql	1970-01-01 00:00:00.000000000 +0000
+++ b/server/src/db/migrations/018_profile_idcards.sql	2026-11-20 10:54:28.724741458 +0000
@@ -0,0 +1,51 @@
+-- Profile pictures + ID card management and scanning.
+-- Additive only: nothing is dropped or rewritten, so it is safe on a database that already holds data.
+
+-- 1. Profile picture. The image itself lives in the configured storage driver (Supabase in production);
+--    only the storage key and a version stamp (used to refresh the picture everywhere) are kept here.
+alter table users add column if not exists avatar_key text;
+alter table users add column if not exists avatar_updated_at timestamptz;
+
+-- 2. Human-readable card numbers, e.g. MR-S-000042
+create sequence if not exists id_card_number_seq;
+
+-- 3. ID cards. One row per card ever issued, so history is kept for audit.
+create table if not exists id_cards (
+  id           uuid primary key default gen_random_uuid(),
+  user_id      uuid not null references users(id) on delete cascade,
+  card_number  text not null unique,
+  token        text not null,                       -- random, unguessable; the QR code carries this, never personal data
+  category     user_role not null,                  -- role at the time of issue
+  status       text not null default 'active' check (status in ('active', 'suspended', 'revoked', 'replaced')),
+  issued_at    timestamptz not null default now(),
+  expires_at   timestamptz,
+  revoked_at   timestamptz,
+  revoked_by   uuid references users(id) on delete set null,
+  revoke_reason text,
+  replaced_by  uuid references id_cards(id) on delete set null,
+  issued_by    uuid references users(id) on delete set null,
+  created_at   timestamptz not null default now()
+);
+-- "Expired" is not stored: it is an active card whose expires_at has passed, so it can never be out of date.
+create unique index if not exists id_cards_token_active_uq on id_cards (token) where status in ('active', 'suspended');
+create unique index if not exists id_cards_one_live_per_user on id_cards (user_id) where status in ('active', 'suspended');
+create index if not exists id_cards_token_idx on id_cards (token);
+create index if not exists id_cards_user_idx on id_cards (user_id, issued_at desc);
+create index if not exists id_cards_status_idx on id_cards (status, issued_at desc);
+
+-- 4. Every scan attempt, valid or not (who scanned, what came back).
+create table if not exists id_card_scans (
+  id         bigserial primary key,
+  card_id    uuid references id_cards(id) on delete set null,
+  scanned_by uuid references users(id) on delete set null,
+  method     text not null check (method in ('qr', 'manual')),
+  outcome    text not null,                         -- valid | invalid | unknown | revoked | expired | replaced | suspended | inactive
+  ip         text,
+  created_at timestamptz not null default now()
+);
+create index if not exists id_card_scans_created_idx on id_card_scans (created_at desc);
+create index if not exists id_card_scans_card_idx on id_card_scans (card_id);
+
+alter table id_cards      enable row level security;
+alter table id_card_scans enable row level security;
+-- The card template (colours, school details, validity, logo key) is kept in the existing `settings` table under the key 'id_card_template'.
diff -ruN a/server/src/db/migrations/019_semesters_classes_mrei.sql b/server/src/db/migrations/019_semesters_classes_mrei.sql
--- a/server/src/db/migrations/019_semesters_classes_mrei.sql	1970-01-01 00:00:00.000000000 +0000
+++ b/server/src/db/migrations/019_semesters_classes_mrei.sql	2026-11-21 19:10:32.272743627 +0000
@@ -0,0 +1,33 @@
+-- Two semesters a year, seven named classes, and the MREI name on new references.
+-- Additive and safe on a database that already holds data: nothing is deleted and existing rows keep their values.
+
+-- 1. Class names. Ihdaady = stage JSS, years 1 to 4; Thaanawiy = stage SSS, years 1 to 3. Existing JSS 1-3 become Ihdaady Awwal-Thaalith
+--    and SSS 1 becomes Thaanawiy Awwal, in that order, with no data change. The arm (A, B...) follows the name after a space.
+create or replace function class_label(stage school_stage, year int, arm text) returns text
+language sql immutable as $$
+  select case
+    when stage = 'JSS' then (array['Ihdaady Awwal', 'Ihdaady Thaany', 'Ihdaady Thaalith', 'Ihdaady Raabih'])[year]
+    else (array['Thaanawiy Awwal', 'Thaanawiy Thaaniy', 'Thaanawiy Thaalith'])[year]
+  end || coalesce(' ' || arm, '')
+$$;
+
+alter table classes drop constraint if exists classes_year_check;
+alter table classes add constraint classes_level_check
+  check ((stage = 'JSS' and year between 1 and 4) or (stage = 'SSS' and year between 1 and 3));
+alter table admission_applications drop constraint if exists admission_applications_class_year_check;
+alter table admission_applications add constraint admission_applications_level_check
+  check ((class_stage = 'JSS' and class_year between 1 and 4) or (class_stage = 'SSS' and class_year between 1 and 3));
+
+-- 2. Semesters. If a database still has third-term rows (data from before this change) the limit is left alone so nothing is lost;
+--    otherwise new sessions are held to two semesters by the database itself.
+do $$
+begin
+  if not exists (select 1 from terms where term_number = 3) then
+    alter table terms drop constraint if exists terms_term_number_check;
+    alter table terms add constraint terms_term_number_check check (term_number between 1 and 2);
+  end if;
+end $$;
+
+-- 3. New application references start with MREI. Existing KOK- references stay as they are and keep working.
+alter table admission_applications alter column reference
+  set default ('MREI-APP-' || lpad(nextval('application_number_seq')::text, 6, '0'));

+// Profile pictures, ID cards, scanning, and editing classes and subjects.
+//   ADMIN_EMAIL=... ADMIN_PASSWORD=... npx tsx tests/phase19.test.ts   (API on :4000, migration 018 applied)
+import sharp from 'sharp';
+import crypto from 'crypto';
+const B = 'http://localhost:4000/api';
+const sfx = Date.now().toString(36);
+let pass = 0, fail = 0;
+async function call(method: string, path: string, token?: string, body?: unknown) {
+  const res = await fetch(B + path, { method, headers: { ...(body ? { 'Content-Type': 'application/json' } : {}), ...(token ? { Authorization: `Bearer ${token}` } : {}) }, body: body ? JSON.stringify(body) : undefined });
+  const json: any = await res.json().catch(() => ({}));
+  return { status: res.status, data: json.data, error: json.error };
+}
+async function raw(method: string, path: string, token?: string, body?: unknown) {
+  const res = await fetch(B + path, { method, headers: { ...(body ? { 'Content-Type': 'application/json' } : {}), ...(token ? { Authorization: `Bearer ${token}` } : {}) }, body: body ? JSON.stringify(body) : undefined });
+  return { status: res.status, type: res.headers.get('content-type') ?? '', buf: Buffer.from(await res.arrayBuffer()) };
+}
+async function upload(path: string, token: string, buf: Buffer, name: string, mime: string, method = 'POST') {
+  const f = new FormData(); f.append('file', new Blob([new Uint8Array(buf)], { type: mime }), name);
+  const res = await fetch(B + path, { method, headers: { Authorization: `Bearer ${token}` }, body: f });
+  const json: any = await res.json().catch(() => ({}));
+  return { status: res.status, data: json.data, error: json.error };
+}
+function check(name: string, got: unknown, want: unknown) {
+  const okk = JSON.stringify(got) === JSON.stringify(want);
+  console.log(`${okk ? 'PASS' : 'FAIL'}  ${name}${okk ? '' : `  (expected ${JSON.stringify(want)}, got ${JSON.stringify(got)})`}`); okk ? pass++ : fail++;
+}
+const PW = 'Sup3rSecret99';
+async function newUser(adminT: string, role: string, extra: Record<string, string> = {}) {
+  const email = `${role}.${sfx}.${Math.random().toString(36).slice(2, 6)}@example.com`;
+  const r = await call('POST', '/users', adminT, { email, role, firstName: role, lastName: sfx, ...extra });
+  await call('POST', '/auth/activate', undefined, { token: r.data.activationLink.split('token=')[1], password: PW });
+  const l = await call('POST', '/auth/login', undefined, { email, password: PW });
+  return { id: r.data.user.id as string, email, token: l.data.accessToken as string, login: l.data };
+}
+const png = (w = 300, h = 200) => sharp({ create: { width: w, height: h, channels: 3, background: '#3a7' } }).png().toBuffer();
+
+(async () => {
+  const { query, pool } = await import('../src/db/pool');
+  const A = (await call('POST', '/auth/login', undefined, { email: process.env.ADMIN_EMAIL, password: process.env.ADMIN_PASSWORD })).data.accessToken as string;
+  const stu = await newUser(A, 'student', { admissionNumber: `PD-${sfx}`, phone: '08030000000' });
+  const stu2 = await newUser(A, 'student', { admissionNumber: `PE-${sfx}` });
+  const tch = await newUser(A, 'teacher', { staffNumber: `PT-${sfx}` });
+  const par = await newUser(A, 'parent');
+  await call('POST', '/parent-links', A, { parentId: par.id, studentId: stu.id, relationship: 'mother' });
+  const y = 2100 + (parseInt(sfx, 36) % 800);
+  const sess = (await call('POST', '/academic/sessions', A, { name: `${y}/${y + 1}`, startDate: '2100-01-01', endDate: '2100-12-31' })).data;
+  await call('POST', `/academic/sessions/${sess.id}/set-current`, A);
+  const tag = 'Q' + sfx.slice(-3).toUpperCase().replace(/[^A-Z0-9]/g, 'X');
+  const cls = (await call('POST', '/academic/classes', A, { stage: 'JSS', year: 1, arm: tag })).data;
+  await call('POST', '/enrolments'.replace('/enrolments', '/academic/enrolments'), A, { studentId: stu.id, classId: cls.id, sessionId: sess.id });
+  await call('POST', '/academic/enrolments', A, { studentId: stu2.id, classId: cls.id, sessionId: sess.id });
+
+  console.log('\n-- profile pictures');
+  const p1 = await upload('/profile/avatar', stu.token, await png(), 'me.png', 'image/png');
+  check('student uploads a PNG', [p1.status, p1.data?.hasAvatar, typeof p1.data?.avatarVersion], [200, true, 'number']);
+  const g1 = await raw('GET', `/profile/users/${stu.id}/avatar`, stu.token);
+  check('own picture is served as JPEG', [g1.status, g1.type, g1.buf.subarray(0, 3).toString('hex')], [200, 'image/jpeg', 'ffd8ff']);
+  const meta = await sharp(g1.buf).metadata(); check('picture is normalised to 512x512', [meta.width, meta.height], [512, 512]);
+  const bad = await upload('/profile/avatar', stu.token, Buffer.from('<html>not an image</html>'), 'x.png', 'image/png');
+  check('text renamed .png is rejected', [bad.status, bad.error?.code], [400, 'BAD_FILE_TYPE']);
+  const svg = await upload('/profile/avatar', stu.token, Buffer.from('<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10"/>'), 'x.png', 'image/png');
+  check('SVG is rejected even when labelled PNG', [svg.status, svg.error?.code], [400, 'BAD_FILE_TYPE']);
+  const big = await upload('/profile/avatar', stu.token, crypto.randomBytes(6 * 1024 * 1024), 'big.png', 'image/png');
+  check('file over 5 MB is rejected', [big.status, big.error?.code], [413, 'FILE_TOO_LARGE']);
+  const webp = await upload('/profile/avatar', stu.token, await sharp(await png()).webp().toBuffer(), 'a.webp', 'image/webp');
+  check('WebP is accepted', [webp.status, webp.data?.hasAvatar], [200, true]);
+  const jpg = await upload('/profile/avatar', stu.token, await sharp(await png()).jpeg().toBuffer(), 'a.jpg', 'image/jpeg');
+  check('JPEG replaces the picture', [jpg.status, jpg.data?.hasAvatar], [200, true]);
+  check('another student cannot read it', (await raw('GET', `/profile/users/${stu.id}/avatar`, stu2.token)).status, 404);
+  check('the linked parent can read it', (await raw('GET', `/profile/users/${stu.id}/avatar`, par.token)).status, 200);
+  check('a teacher can read it', (await raw('GET', `/profile/users/${stu.id}/avatar`, tch.token)).status, 200);
